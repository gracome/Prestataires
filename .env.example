# ---------------------------------------------------------------------------
# Prestataire App — environment
#
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL 14 or later. The booking system relies on a GiST exclusion
# constraint and the btree_gist extension, both standard in PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prestataire?schema=public"

# Public origin. Used to build the links in emails and the OAuth redirect.
APP_URL="http://localhost:3000"

# 32 bytes, hex or base64. Encrypts the Google tokens at rest.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY="change-me-generate-with-openssl-rand-hex-32"

# Shared secret for POST /api/jobs/run. Without it, that endpoint is disabled.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=""

# Session cookie name and lifetime in hours.
SESSION_COOKIE_NAME="prestataire_session"
SESSION_TTL_HOURS=168

# --- File storage ----------------------------------------------------------
# "local" writes under STORAGE_LOCAL_DIR, which must sit OUTSIDE the public
# web root: payment proofs are served only through an authorised route.
# "s3" works with any S3-compatible host (AWS, Scaleway, Backblaze, R2, MinIO).

STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3_BUCKET=""
# S3_REGION="eu-west-3"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Email -----------------------------------------------------------------
# "console" prints messages to the server log, which is what you want in
# development. Use "smtp" or "resend" in production.

MAIL_DRIVER="console"
MAIL_FROM="Prestataire <no-reply@example.com>"

# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""

# RESEND_API_KEY=""

# --- Google Calendar -------------------------------------------------------
# Optional. Create OAuth 2.0 credentials in Google Cloud Console, enable the
# Google Calendar API, and add APP_URL/api/google/callback as a redirect URI.

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Direct (session-mode) connection used only by Prisma Migrate. Behind a
# pooler such as Neon's pooled endpoint, migrations cannot run on
# DATABASE_URL. In development, set it to the same value.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/prestataire?schema=public"
